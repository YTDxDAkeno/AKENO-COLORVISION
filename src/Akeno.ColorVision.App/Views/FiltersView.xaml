<UserControl x:Class="Akeno.ColorVision.App.Views.FiltersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Akeno.ColorVision.App.Controls">
  <StackPanel>
    <TextBlock Text="Color Filters" Style="{StaticResource Text.PageTitle}" AutomationProperties.HeadingLevel="Level1" />
    <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,6,0,22" MaxWidth="820" HorizontalAlignment="Left"
               Text="Pick a correction method and how strong it should be. Every setting on this page is a real change to the color transform applied to your screen." />

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="300" />
        <ColumnDefinition Width="20" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Profile list -->
      <Border Style="{StaticResource Card}" VerticalAlignment="Top">
        <StackPanel>
          <TextBlock Text="Profiles" Style="{StaticResource Text.CardTitle}" Margin="0,0,0,10" />
          <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" AutomationProperties.Name="Profiles">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel>
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text}" />
                  <TextBlock x:Name="Origin" Text="Your profile" Style="{StaticResource Text.Caption}" />
                </StackPanel>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding IsBuiltIn}" Value="True">
                    <Setter TargetName="Origin" Property="Text" Value="Built-in preset" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </Border>

      <StackPanel Grid.Column="2">
        <!-- Details -->
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Section}" />
            <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Body}" />
            <StackPanel Orientation="Horizontal" Margin="0,12,0,14">
              <TextBlock Text="&#xE946;" Style="{StaticResource Text.Icon}" FontSize="16" Margin="0,0,8,0" />
              <TextBlock Text="{Binding ActiveText}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center" />
            </StackPanel>
            <WrapPanel>
              <Button Content="Use this profile" Command="{Binding UseCommand}" Margin="0,0,8,8" />
              <Button Content="Use it and turn the filter on" Command="{Binding UseAndTurnOnCommand}" Style="{StaticResource AccentButton}" Margin="0,0,8,8" />
              <Button Content="Customize a copy" Command="{Binding CustomizeCopyCommand}" Margin="0,0,8,8"
                      Visibility="{Binding IsBuiltIn, Converter={StaticResource BoolToVisibility}}" />
            </WrapPanel>
          </StackPanel>
        </Border>

        <!-- Strength -->
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <controls:SliderRow Label="Correction strength" Value="{Binding Intensity}" Minimum="0" Maximum="1" Step="0.05" Format="P0"
                                LeftHint="Gentle (closer to original colors)" RightHint="Strong"
                                Help="How much of this profile's color change is applied. Saturation, contrast and brightness below are applied as set." />
          </StackPanel>
        </Border>

        <!-- Preview -->
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Preview" Style="{StaticResource Text.CardTitle}" />
            <TextBlock Text="{Binding PreviewNote}" Style="{StaticResource Text.Secondary}" Margin="0,4,0,12" />
            <Border Style="{StaticResource SwatchFrame}">
              <ItemsControl ItemsSource="{Binding PreviewPairs}" Focusable="False">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Width="150" Margin="6,6,6,10">
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border Width="60" Height="60" CornerRadius="6" Background="{Binding First}" Margin="0,0,6,0" ToolTip="{Binding FirstName}" />
                        <Border Width="60" Height="60" CornerRadius="6" Background="{Binding Second}" ToolTip="{Binding SecondName}" />
                      </StackPanel>
                      <TextBlock Text="{Binding Label}" Foreground="White" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
            <Button x:Name="CompareButton" Content="Hold to compare with original colors" Margin="0,12,0,0" HorizontalAlignment="Left"
                    PreviewMouseLeftButtonDown="OnCompareDown" PreviewMouseLeftButtonUp="OnCompareUp" MouseLeave="OnCompareUp"
                    PreviewKeyDown="OnCompareKeyDown" PreviewKeyUp="OnCompareKeyUp"
                    ToolTip="While you hold this button (or the Space key), the filter is paused so you can see the original colors." />
          </StackPanel>
        </Border>

        <!-- Custom settings -->
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Custom settings" Style="{StaticResource Text.CardTitle}" />
            <Border Style="{StaticResource Notice}" Margin="0,10,0,10" Visibility="{Binding IsBuiltIn, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Style="{StaticResource Text.Body}" Text="Built-in presets can't be changed. Click &quot;Customize a copy&quot; above to make your own version you can adjust." />
            </Border>

            <StackPanel IsEnabled="{Binding IsEditable}" Margin="0,8,0,0">
              <TextBlock Text="Starting correction model" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
              <StackPanel Orientation="Horizontal" Margin="0,6,0,4">
                <RadioButton Content="None" GroupName="BaseModel" Margin="0,0,20,0"
                             IsChecked="{Binding BaseModel, Converter={StaticResource Equals}, ConverterParameter=None}" />
                <RadioButton Content="Protan-oriented (red cone)" GroupName="BaseModel" Margin="0,0,20,0"
                             IsChecked="{Binding BaseModel, Converter={StaticResource Equals}, ConverterParameter=ProtanDaltonization}" />
                <RadioButton Content="Deutan-oriented (green cone)" GroupName="BaseModel"
                             IsChecked="{Binding BaseModel, Converter={StaticResource Equals}, ConverterParameter=DeutanDaltonization}" />
              </StackPanel>
              <TextBlock Style="{StaticResource Text.Caption}" Margin="0,0,0,14"
                         Text="Daltonization based on a scientific color vision model (Machado et al. 2009). It is a design model, not a diagnosis." />

              <controls:SliderRow Label="Assumed severity (for the model above)" Value="{Binding ModelSeverity}" Minimum="0.1" Maximum="1" Step="0.05" Format="P0"
                                  LeftHint="Mild" RightHint="Strong" />
              <controls:SliderRow Label="Red ↔ green separation (blue / yellow)" Value="{Binding RedGreenToBlue}" Minimum="0" Maximum="1.2" Step="0.05" Format="0.00"
                                  LeftHint="Off" RightHint="Maximum"
                                  Help="Reds get more blue (purple/pink), greens get less blue (yellower). Blue-yellow differences usually stay visible with red-green color vision differences." />
              <controls:SliderRow Label="Red ↔ green brightness difference" Value="{Binding RedGreenToLightness}" Minimum="-0.5" Maximum="0.5" Step="0.05" Format="+0.00;-0.00;0"
                                  LeftHint="Reds darker, greens lighter" RightHint="Reds lighter, greens darker"
                                  Help="Turns the red/green difference into a light/dark difference." />
              <controls:SliderRow Label="Red hue shift" Value="{Binding RedHueShift}" Minimum="-60" Maximum="60" Step="5" Format="+0°;-0°;0°"
                                  LeftHint="Toward pink / magenta" RightHint="Toward orange" />
              <controls:SliderRow Label="Green hue shift" Value="{Binding GreenHueShift}" Minimum="-60" Maximum="60" Step="5" Format="+0°;-0°;0°"
                                  LeftHint="Toward yellow" RightHint="Toward cyan / teal" />
              <controls:SliderRow Label="Saturation" Value="{Binding Saturation}" Minimum="0" Maximum="2" Step="0.05" Format="0.00"
                                  LeftHint="Gray" RightHint="Very colorful" />
              <controls:SliderRow Label="Contrast" Value="{Binding Contrast}" Minimum="0.5" Maximum="1.6" Step="0.05" Format="0.00"
                                  LeftHint="Flat" RightHint="Punchy" />
              <controls:SliderRow Label="Brightness" Value="{Binding Brightness}" Minimum="-0.25" Maximum="0.25" Step="0.01" Format="+0.00;-0.00;0"
                                  LeftHint="Darker" RightHint="Brighter" />

              <TextBlock Text="{Binding ParameterSummary}" Style="{StaticResource Text.Caption}" Margin="0,0,0,10" />
              <Border Style="{StaticResource WarningNotice}" Visibility="{Binding ValidationWarning, Converter={StaticResource NullToVisibility}}">
                <TextBlock Text="{Binding ValidationWarning}" Style="{StaticResource Text.Body}" />
              </Border>
              <Button Content="Reset these settings" Command="{Binding ResetParametersCommand}" HorizontalAlignment="Left" />
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
  </StackPanel>
</UserControl>
