<UserControl x:Class="Akeno.ColorVision.App.Views.IdentifierView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <TextBlock Text="Color Identifier" Style="{StaticResource Text.PageTitle}" AutomationProperties.HeadingLevel="Level1" />
    <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,6,0,22" MaxWidth="820" HorizontalAlignment="Left"
               Text="Find out the name of any color on your screen — in words, so you don't have to judge the color itself." />

    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Text="How to use it" Style="{StaticResource Text.CardTitle}" />
        <TextBlock Style="{StaticResource Text.Body}" Margin="0,6,0,14">
          <Run Text="Point the mouse at a color anywhere and press " /><Run Text="{Binding ShortcutText, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=". The name appears next to the mouse pointer." />
        </TextBlock>
        <WrapPanel>
          <Button Content="Identify in 3 seconds" Command="{Binding SampleSoonCommand}" Style="{StaticResource AccentButton}" Margin="0,0,8,8" />
          <Button Content="{Binding LiveButtonText}" Command="{Binding ToggleLiveCommand}" Margin="0,0,8,8" />
        </WrapPanel>
        <TextBlock Text="{Binding Countdown}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" AutomationProperties.LiveSetting="Assertive"
                   Visibility="{Binding Countdown, Converter={StaticResource NullToVisibility}}" />
        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0"
                   Text="Live mode follows the mouse and keeps naming the color under it. It never takes focus away from your game or app." />
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Card}" Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
      <DockPanel>
        <Border DockPanel.Dock="Left" Width="132" Height="132" CornerRadius="12" Background="{Binding SwatchBrush}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="2" Margin="0,0,20,0" VerticalAlignment="Top"
                AutomationProperties.Name="Sampled color" />
        <StackPanel>
          <TextBlock Text="{Binding ColorName}" Style="{StaticResource Text.PageTitle}" AutomationProperties.LiveSetting="Assertive" />
          <TextBlock Text="{Binding Category}" Style="{StaticResource Text.Section}" Margin="0,4,0,4" />
          <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Body}" />
          <TextBlock Style="{StaticResource Text.Body}" Margin="0,4,0,8">
            <Run Text="{Binding Hex, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding RgbText, Mode=OneWay}" />
          </TextBlock>
          <TextBlock Text="{Binding SourceLabel}" Style="{StaticResource Text.Caption}" />
          <Border Style="{StaticResource WarningNotice}" Margin="0,10,0,0" Visibility="{Binding BlockedWarning, Converter={StaticResource NullToVisibility}}">
            <TextBlock Text="{Binding BlockedWarning}" Style="{StaticResource Text.Body}" />
          </Border>
        </StackPanel>
      </DockPanel>
    </Border>

    <Border Style="{StaticResource Card}" Visibility="{Binding HasHistory, Converter={StaticResource BoolToVisibility}}">
      <StackPanel>
        <Grid Margin="0,0,0,8">
          <TextBlock Text="Recent colors" Style="{StaticResource Text.CardTitle}" />
          <Button Content="Clear" Command="{Binding ClearHistoryCommand}" HorizontalAlignment="Right" />
        </Grid>
        <ItemsControl ItemsSource="{Binding History}" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Margin="0,4">
                <Border Width="28" Height="28" CornerRadius="6" Background="{Binding ReportedColor, Converter={StaticResource RgbToBrush}}"
                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" />
                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text}">
                  <Run Text="{Binding Description.Name, Mode=OneWay}" FontWeight="SemiBold" />
                  <Run Text=" — " /><Run Text="{Binding Description.Category, Mode=OneWay}" />
                  <Run Text="  ·  " /><Run Text="{Binding Description.Hex, Mode=OneWay}" />
                </TextBlock>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Text="Original or filtered colors?" Style="{StaticResource Text.CardTitle}" />
        <TextBlock Text="{Binding SamplingStatus}" Style="{StaticResource Text.Body}" Margin="0,6,0,12" />
        <Button Content="Run the check now" Command="{Binding RunCheckCommand}" HorizontalAlignment="Left" />
        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,6,0,0" Text="The check needs the filter to be on. It briefly shows a small colored square and reads it back." />
        <TextBlock Text="{Binding CheckMessage}" Style="{StaticResource Text.Body}" Margin="0,8,0,0" Visibility="{Binding CheckMessage, Converter={StaticResource NullToVisibility}}" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
