<UserControl x:Class="Akeno.ColorVision.App.Views.GamingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <TextBlock Text="Gaming" Style="{StaticResource Text.PageTitle}" AutomationProperties.HeadingLevel="Level1" />
    <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,6,0,22" MaxWidth="820" HorizontalAlignment="Left"
               Text="Use a stronger profile while you play, and switch to it automatically when Minecraft is in front. No game files are changed and nothing is injected into games." />

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="20" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Style="{StaticResource Card}" VerticalAlignment="Top">
        <StackPanel>
          <TextBlock Text="Minecraft profile" Style="{StaticResource Text.CardTitle}" />
          <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,4,0,10"
                     Text="Used while Minecraft is in front. &quot;Minecraft — Nether Visibility&quot; is tuned for dark reds, browns and grays." />
          <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8" Padding="6">
            <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding MinecraftProfile}" MaxHeight="260" AutomationProperties.Name="Minecraft profile">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>
          <Button Content="Use it now and turn the filter on" Command="{Binding UseNowCommand}" Style="{StaticResource AccentButton}"
                  HorizontalAlignment="Left" Margin="0,12,0,0" />
        </StackPanel>
      </Border>

      <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
        <StackPanel>
          <TextBlock Text="Automatic switching" Style="{StaticResource Text.CardTitle}" Margin="0,0,0,6" />
          <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding AutoSwitch}" Content="Switch to the Minecraft profile when Minecraft is in front" />
          <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding EnableFilterWhileGaming}" Content="Also turn the filter on while playing" />
          <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding QuietWhileGaming}" Content="No on-screen messages while playing" />
          <Border Style="{StaticResource Notice}" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE7FC;" Style="{StaticResource Text.Icon}" Margin="0,0,10,0" />
              <TextBlock Text="{Binding DetectionStatus}" Style="{StaticResource Text.Body}" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
          </Border>
          <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0"
                     Text="Detection only looks at the program name and window title of the app in front. When the game closes or you switch away, your previous profile comes back after a moment." />
        </StackPanel>
      </Border>
    </Grid>

    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Text="Recognized games" Style="{StaticResource Text.CardTitle}" Margin="0,0,0,8" />
        <ItemsControl ItemsSource="{Binding Rules}" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="0,8">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="Remove" Command="{Binding RemoveCommand}" Margin="12,0,0,0"
                          Visibility="{Binding IsBuiltIn, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                  <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding Enabled}" AutomationProperties.Name="{Binding Name}" Margin="12,0,0,0" />
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Caption}" />
                  </StackPanel>
                </DockPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Text="Add another game or app" Style="{StaticResource Text.CardTitle}" />
        <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,4,0,10"
                   Text="Start the game, come back here, click &quot;Show running apps&quot;, pick it, and add it. It will use the Minecraft profile chosen above." />
        <Button Content="Show running apps" Command="{Binding RefreshAppsCommand}" HorizontalAlignment="Left" />
        <ListBox ItemsSource="{Binding RunningApps}" SelectedItem="{Binding SelectedApp}" MaxHeight="240" Margin="0,10,0,10" AutomationProperties.Name="Running apps">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel>
                <TextBlock Text="{Binding ExecutableName}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
                <TextBlock Text="{Binding WindowTitle}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <Button Content="Add selected app" Command="{Binding AddRuleCommand}" Style="{StaticResource AccentButton}" HorizontalAlignment="Left" />
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Text="Tips for the best results" Style="{StaticResource Text.CardTitle}" Margin="0,0,0,6" />
        <TextBlock Style="{StaticResource Text.Body}" Margin="0,2" Text="• Play in windowed or borderless mode if the filter does not show up in the game. Some exclusive-fullscreen games bypass Windows' screen color effects." />
        <TextBlock Style="{StaticResource Text.Body}" Margin="0,2" Text="• Minecraft: Java Edition — if F11 fullscreen is not filtered on your PC, press F11 again to use a maximized window instead." />
        <TextBlock Style="{StaticResource Text.Body}" Margin="0,2" Text="• In the Nether, raising Minecraft's own Brightness setting (Options → Video Settings) makes dark blocks easier to separate together with the filter." />
        <TextBlock Style="{StaticResource Text.Body}" Margin="0,2" Text="• Toggle the filter any time with your shortcut to compare." />
        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,8,0,0" Text="In-game compatibility has not yet been verified on real hardware for this version; see About → Compatibility." />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
