<UserControl x:Class="Akeno.ColorVision.App.Views.ProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <TextBlock Text="Profiles" Style="{StaticResource Text.PageTitle}" AutomationProperties.HeadingLevel="Level1" />
    <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,6,0,22" MaxWidth="820" HorizontalAlignment="Left"
               Text="Your saved color settings. Profiles are stored only on this PC. You can export one to keep a backup or to use it on another computer." />

    <Border Style="{StaticResource Notice}" Visibility="{Binding Message, Converter={StaticResource NullToVisibility}}">
      <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Body}" AutomationProperties.LiveSetting="Polite" />
    </Border>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="340" />
        <ColumnDefinition Width="20" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Style="{StaticResource Card}" VerticalAlignment="Top">
        <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding Selected}" AutomationProperties.Name="Saved profiles">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel>
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" />
                <TextBlock x:Name="Origin" Text="Your profile" Style="{StaticResource Text.Caption}" />
              </StackPanel>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsBuiltIn}" Value="True">
                  <Setter TargetName="Origin" Property="Text" Value="Built-in preset" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <StackPanel Grid.Column="2">
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="{Binding Selected.Name}" Style="{StaticResource Text.Section}" />
            <TextBlock Text="{Binding Details}" Style="{StaticResource Text.Body}" Margin="0,0,0,8" />
            <TextBlock Text="{Binding Selected.Description}" Style="{StaticResource Text.Secondary}" Margin="0,0,0,14" />
            <WrapPanel>
              <Button Content="Make active" Command="{Binding ActivateCommand}" Style="{StaticResource AccentButton}" Margin="0,0,8,8" />
              <Button Content="Duplicate" Command="{Binding DuplicateCommand}" Margin="0,0,8,8" />
              <Button Content="Rename…" Command="{Binding RenameCommand}" Margin="0,0,8,8" />
              <Button Content="Export…" Command="{Binding ExportCommand}" Margin="0,0,8,8" />
              <Button Content="Delete…" Command="{Binding DeleteCommand}" Margin="0,0,8,8" />
            </WrapPanel>
            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0">
              <Run Text="Active profile: " /><Run Text="{Binding ActiveName, Mode=OneWay}" FontWeight="SemiBold" />
            </TextBlock>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Import and reset" Style="{StaticResource Text.CardTitle}" Margin="0,0,0,8" />
            <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,0,0,12"
                       Text="Imported profiles are checked for safety before use. If you try one, you get 15 seconds to keep it — otherwise your previous colors come back automatically." />
            <WrapPanel>
              <Button Content="Import a profile…" Command="{Binding ImportCommand}" Margin="0,0,8,8" />
              <Button Content="Reset built-in preset strengths" Command="{Binding ResetStrengthsCommand}" Margin="0,0,8,8" />
            </WrapPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
  </StackPanel>
</UserControl>
