<UserControl x:Class="Akeno.ColorVision.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <TextBlock Text="Make colors easier to distinguish." Style="{StaticResource Text.PageTitle}" AutomationProperties.HeadingLevel="Level1" />
    <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,6,0,22" MaxWidth="820" HorizontalAlignment="Left"
               Text="Akeno ColorVision changes the colors on your whole screen so that colors which normally look the same become different colors or different brightness. It can't cure color blindness — it helps you tell things apart." />

    <!-- Notices (safe mode, conflicts, problems) -->
    <ItemsControl ItemsSource="{Binding Notices}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border x:Name="NoticeBorder" Style="{StaticResource Notice}">
            <DockPanel>
              <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" Style="{StaticResource Text.Icon}" FontSize="20" Margin="0,2,12,0" VerticalAlignment="Top" />
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                <Button Content="{Binding ActionText}" Command="{Binding ActionCommand}" Margin="0,0,8,0"
                        Visibility="{Binding ActionText, Converter={StaticResource NullToVisibility}}" />
                <Button Content="Dismiss" Command="{Binding DismissCommand}" />
              </StackPanel>
              <StackPanel>
                <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text}">
                  <Run Text="{Binding Kind, Mode=OneWay}" /><Run Text=": " /><Run Text="{Binding Title, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Secondary}" Margin="0,2,0,0" />
              </StackPanel>
            </DockPanel>
          </Border>
          <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsWarning}" Value="True">
              <Setter TargetName="NoticeBorder" Property="Style" Value="{StaticResource WarningNotice}" />
            </DataTrigger>
          </DataTemplate.Triggers>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <Border Style="{StaticResource Notice}" Visibility="{Binding ShowFirstRunHint, Converter={StaticResource BoolToVisibility}}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Start calibration" Command="{Binding CalibrateCommand}" Style="{StaticResource AccentButton}" Margin="12,0,0,0" />
        <StackPanel>
          <TextBlock Text="New here? Start with calibration." FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
          <TextBlock Style="{StaticResource Text.Secondary}" Text="It takes about 5 minutes and finds the settings that work best for your eyes on this screen. It is not a medical test." />
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Margin="0,4,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="20" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Filter on/off -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="COLOR FILTER" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}" />
          <StackPanel Orientation="Horizontal" Margin="0,8,0,6">
            <TextBlock Text="{Binding StatusGlyph}" Style="{StaticResource Text.Icon}" FontSize="26" Margin="0,0,12,0" />
            <TextBlock Text="{Binding Headline}" Style="{StaticResource Text.Big}" AutomationProperties.LiveSetting="Polite" />
          </StackPanel>
          <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource Text.Secondary}" Margin="0,0,0,16" />
          <Button Content="{Binding ToggleText}" Command="{Binding ToggleCommand}" Style="{StaticResource AccentButton}"
                  MinHeight="52" FontSize="17" HorizontalAlignment="Left" MinWidth="240" />
          <TextBlock Text="{Binding ShortcutHint}" Style="{StaticResource Text.Caption}" Margin="0,10,0,0" />
          <Border Style="{StaticResource Notice}" Margin="0,12,0,0" Visibility="{Binding GameText, Converter={StaticResource NullToVisibility}}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE7FC;" Style="{StaticResource Text.Icon}" Margin="0,0,10,0" />
              <TextBlock Text="{Binding GameText}" Style="{StaticResource Text.Body}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

      <!-- Profile and strength -->
      <Border Grid.Column="2" Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="CURRENT PROFILE" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}" />
          <TextBlock Text="{Binding ActiveProfileName}" Style="{StaticResource Text.Big}" Margin="0,8,0,18" />
          <Grid>
            <TextBlock Text="Correction strength" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
            <TextBlock Text="{Binding IntensityText}" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="{DynamicResource Brush.Text}" />
          </Grid>
          <Slider Value="{Binding Intensity}" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1" TickFrequency="0.05"
                  IsSnapToTickEnabled="True" Margin="0,6,0,2" AutomationProperties.Name="Correction strength" />
          <Grid>
            <TextBlock Text="Gentle" Style="{StaticResource Text.Caption}" />
            <TextBlock Text="Strong" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" />
          </Grid>
          <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <Button Content="Adjust profile…" Command="{Binding FiltersCommand}" Margin="0,0,8,0" />
            <Button Content="Identify a color" Command="{Binding IdentifyCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Profiles -->
    <TextBlock Text="Choose a profile" Style="{StaticResource Text.Section}" Margin="0,8,0,10" AutomationProperties.HeadingLevel="Level2" />
    <ItemsControl ItemsSource="{Binding Cards}" Focusable="False">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <RadioButton Style="{StaticResource CardRadio}" GroupName="HomeProfiles" Width="330" Margin="0,0,12,12"
                       IsChecked="{Binding IsActive, Mode=TwoWay}" AutomationProperties.Name="{Binding Name}">
            <StackPanel>
              <TextBlock Text="{Binding Name}" Style="{StaticResource Text.CardTitle}" />
              <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" MaxHeight="58" TextTrimming="WordEllipsis" />
            </StackPanel>
          </RadioButton>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- Help -->
    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
      <StackPanel>
        <TextBlock Text="If the screen ever looks wrong" Style="{StaticResource Text.CardTitle}" AutomationProperties.HeadingLevel="Level2" />
        <TextBlock Style="{StaticResource Text.Body}" Margin="0,6,0,12">
          <Run Text="Press " /><Run Text="{Binding EmergencyShortcut, Mode=OneWay}" FontWeight="SemiBold" />
          <Run Text=" or click Reset colors. You can also run AkenoColorVision-EmergencyReset.exe from the app folder — it works even if this window is frozen." />
        </TextBlock>
        <Button Content="Reset colors now" Command="{Binding ResetCommand}" Style="{StaticResource WarningButton}" HorizontalAlignment="Left" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
