<Window x:Class="Akeno.ColorVision.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Akeno ColorVision"
        Width="1200" Height="820" MinWidth="920" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/akeno.ico"
        Background="{DynamicResource Brush.Window}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="{StaticResource Font.Ui}"
        FontSize="15"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <!-- Navigation list item: selection shown with a bar, background AND bold text. -->
    <Style x:Key="NavItem" TargetType="ListBoxItem">
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
      <Setter Property="Margin" Value="10,2" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Root" Height="46" CornerRadius="8" Background="Transparent">
              <Grid>
                <Rectangle x:Name="Indicator" Width="4" Height="22" RadiusX="2" RadiusY="2" HorizontalAlignment="Left"
                           Margin="2,0,0,0" Fill="{DynamicResource Brush.Accent}" Visibility="Collapsed" />
                <StackPanel Orientation="Horizontal" Margin="16,0,8,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Glyph}" Style="{StaticResource Text.Icon}" Width="24" />
                  <TextBlock x:Name="Label" Text="{Binding Title}" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="15" />
                </StackPanel>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
                <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="256" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- ===================== Navigation rail ===================== -->
    <Border Background="{DynamicResource Brush.NavBackground}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="22,24,16,20">
          <Image Source="pack://application:,,,/Assets/akeno-256.png" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality"
                 AutomationProperties.Name="Akeno ColorVision logo" />
          <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="AKENO" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Brush.Text}" />
            <TextBlock Text="COLORVISION" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}" />
          </StackPanel>
        </StackPanel>

        <!-- Always-visible filter status and emergency reset. -->
        <StackPanel DockPanel.Dock="Bottom" Margin="14,8,14,18">
          <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                  CornerRadius="12" Padding="14,12" Margin="0,0,0,10">
            <StackPanel>
              <TextBlock FontSize="13" Foreground="{DynamicResource Brush.TextSecondary}" Text="Color filter" />
              <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}"
                         AutomationProperties.LiveSetting="Polite">
                <Run Text="Filter is " /><Run Text="{Binding FilterStateText, Mode=OneWay}" />
              </TextBlock>
              <TextBlock Text="{Binding ActiveProfileName}" FontSize="13" Foreground="{DynamicResource Brush.TextSecondary}"
                         TextTrimming="CharacterEllipsis" Margin="0,2,0,10" />
              <Button Command="{Binding ToggleFilterCommand}" Style="{StaticResource AccentButton}" Content="{Binding ToggleText}" />
            </StackPanel>
          </Border>
          <Button Command="{Binding EmergencyResetCommand}" Style="{StaticResource WarningButton}"
                  AutomationProperties.Name="Reset screen colors (emergency)"
                  ToolTip="Immediately turns the filter off and restores normal screen colors.">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE72C;" Style="{StaticResource Text.Icon}" Foreground="{DynamicResource Brush.WarningText}" FontSize="16" />
              <TextBlock Text="Reset colors" Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <TextBlock Margin="2,6,0,0" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap">
            <Run Text="Emergency shortcut:" /><LineBreak /><Run Text="{Binding EmergencyShortcut, Mode=OneWay}" FontWeight="SemiBold" />
          </TextBlock>
        </StackPanel>

        <ListBox ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav}" ItemContainerStyle="{StaticResource NavItem}"
                 AutomationProperties.Name="Main navigation" KeyboardNavigation.TabNavigation="Once" />
      </DockPanel>
    </Border>

    <!-- ===================== Page content ===================== -->
    <ScrollViewer Grid.Column="1" x:Name="PageScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Focusable="False" PanningMode="VerticalOnly">
      <ContentControl Content="{Binding CurrentPage}" Margin="36,30,36,36" MaxWidth="1100" HorizontalAlignment="Stretch" Focusable="False" />
    </ScrollViewer>
  </Grid>
</Window>
