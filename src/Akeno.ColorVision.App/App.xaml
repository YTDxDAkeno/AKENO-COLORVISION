<Application x:Class="Akeno.ColorVision.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Akeno.ColorVision.App.ViewModels"
             xmlns:views="clr-namespace:Akeno.ColorVision.App.Views"
             xmlns:conv="clr-namespace:Akeno.ColorVision.App.Converters"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Index 0 is replaced at runtime by ThemeService (dark/light). -->
        <ResourceDictionary Source="Themes/Colors.Dark.xaml" />
        <ResourceDictionary Source="Themes/Styles.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
      <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
      <conv:InverseBoolConverter x:Key="InverseBool" />
      <conv:RgbToBrushConverter x:Key="RgbToBrush" />
      <conv:PercentConverter x:Key="Percent" />
      <conv:EqualsConverter x:Key="Equals" />

      <!-- Page view-models are rendered by their views. -->
      <DataTemplate DataType="{x:Type vm:HomeViewModel}"><views:HomeView /></DataTemplate>
      <DataTemplate DataType="{x:Type vm:FiltersViewModel}"><views:FiltersView /></DataTemplate>
      <DataTemplate DataType="{x:Type vm:CalibrationViewModel}"><views:CalibrationView /></DataTemplate>
      <DataTemplate DataType="{x:Type vm:GamingViewModel}"><views:GamingView /></DataTemplate>
      <DataTemplate DataType="{x:Type vm:IdentifierViewModel}"><views:IdentifierView /></DataTemplate>
      <DataTemplate DataType="{x:Type vm:ProfilesViewModel}"><views:ProfilesView /></DataTemplate>
      <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView /></DataTemplate>
      <DataTemplate DataType="{x:Type vm:AboutViewModel}"><views:AboutView /></DataTemplate>
    </ResourceDictionary>
  </Application.Resources>
</Application>
