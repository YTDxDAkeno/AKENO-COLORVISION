<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Light theme tokens (same keys as the dark theme). -->
  <SolidColorBrush x:Key="Brush.Window" Color="#F3F3F8" />
  <SolidColorBrush x:Key="Brush.NavBackground" Color="#E9E9F2" />
  <SolidColorBrush x:Key="Brush.Surface" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#EEEEF5" />
  <SolidColorBrush x:Key="Brush.SurfaceHover" Color="#E3E3EE" />
  <SolidColorBrush x:Key="Brush.SurfacePressed" Color="#D7D7E5" />
  <SolidColorBrush x:Key="Brush.Border" Color="#CFCFDD" />
  <SolidColorBrush x:Key="Brush.Text" Color="#15161C" />
  <SolidColorBrush x:Key="Brush.TextSecondary" Color="#4E5163" />
  <SolidColorBrush x:Key="Brush.TextDisabled" Color="#9A9CAA" />
  <SolidColorBrush x:Key="Brush.Accent" Color="#5A49DE" />
  <SolidColorBrush x:Key="Brush.AccentHover" Color="#4A3ACB" />
  <SolidColorBrush x:Key="Brush.AccentPressed" Color="#3D2FB3" />
  <SolidColorBrush x:Key="Brush.AccentSoft" Color="#E6E2FF" />
  <SolidColorBrush x:Key="Brush.AccentText" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Brush.Focus" Color="#3D2FB3" />
  <SolidColorBrush x:Key="Brush.Info" Color="#1F6FC2" />
  <SolidColorBrush x:Key="Brush.InfoSoft" Color="#E3EEFB" />
  <SolidColorBrush x:Key="Brush.Warning" Color="#C98A00" />
  <SolidColorBrush x:Key="Brush.WarningSoft" Color="#FFF3D6" />
  <SolidColorBrush x:Key="Brush.WarningText" Color="#1A1400" />
  <SolidColorBrush x:Key="Brush.SwatchSurround" Color="#595959" />
</ResourceDictionary>
