<Project Sdk="Microsoft.NET.Sdk">
  <!-- Win32 interop that is not tied to a UI framework: message-pump threads, hotkeys,
       foreground-window tracking, screen sampling, environment checks, startup registration. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Akeno.ColorVision.Windows</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Akeno.ColorVision.Core\Akeno.ColorVision.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Akeno.ColorVision.IntegrationTests" />
  </ItemGroup>
</Project>
